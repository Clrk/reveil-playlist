<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up or transfer the YouTube Music session cookies (shared_prefs/account.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
    </device-transfer>
</data-extraction-rules>
